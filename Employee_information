class Employee:

    company_name = "Chevron Software Managements"
    num_of_employees = 0
   
    def __init__(self, name: str, age:int, position: str, salary:int):
        self.name = name
        self.age = age
        self.position = position
        self.salary = salary
        Employee.num_of_employees +=1
    
